# Telegram Crypto Alert Bot Configuration

# The bot token obtained from BotFather (e.g., 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# The Telegram chat/channel ID where the bot listens to admin commands (e.g., -1001234567890 for channels, or a private user ID)
ADMIN_CHAT_ID=your_admin_channel_or_chat_id_here

# The Telegram chat/channel ID where the bot posts crypto price alerts (e.g., -1009876543210 for target channels)
TARGET_CHAT_ID=your_target_channel_or_chat_id_here

# Interval in seconds to poll pricing endpoints for watched assets (default is 10 seconds)
POLL_INTERVAL=10

# Configurable endpoints for the market analyzer bot api
MARKET_ANALYZER_URL=http://127.0.0.1:8000/api/v1/analyze
