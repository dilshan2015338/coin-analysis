# Telegram Crypto Alert Bot Configuration

# The bot token obtained from BotFather (e.g., 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# The Telegram chat/channel ID where the bot listens to admin commands (e.g., -1001234567890 for channels, or a private user ID)
# Supports single ID, comma-separated IDs (e.g., -1001234567890, -1009876543210), or ADMIN_CHAT_ID_ME below
ADMIN_CHAT_ID=your_admin_channel_or_chat_id_here
# Optional additional groups authorized for /analyze and other commands:
# ALLOWED_CHAT_IDS=-1001234567890,-1009876543210

# The Telegram chat/channel ID where the bot posts crypto price alerts (e.g., -1009876543210 for target channels)
TARGET_CHAT_ID=your_target_channel_or_chat_id_here

# Interval in seconds to poll pricing endpoints for watched assets (default is 10 seconds)
POLL_INTERVAL=10

# Configurable endpoints for the market analyzer bot api
MARKET_ANALYZER_URL=http://127.0.0.1:8000/api/v1/analyze
MARKET_ANALYZER_API_KEY=lF2vIg=Pik8S_(^iC8$23H&fBz$4h7L6-rOCiZ*x&a#bjvp+(fF_9hTII5aul@gq

# Automated Trade Signal Alerts (CRITICAL SHORT/LONG alerts). Set to true to enable for main channel.
ENABLE_TRADE_ALERTS=false

# Personal "ME" Channel & Bot Configuration (for detailed pulse + stop-loss/squeeze alerts)
TELEGRAM_BOT_TOKEN_ME=your_personal_bot_token_here
ADMIN_CHAT_ID_ME=your_personal_admin_chat_id_here
TARGET_CHAT_ID_ME=your_personal_target_chat_id_here
